        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass ContenidoAudiovisual {\n  -id\n  -String titulo\n  -int duracionEnMinutos\n  -String genero\n  +getId()\n  +getTitulo()\n  +getDuracionEnMinutos()\n  +getGenero()\n  +mostrarDetalles()\n}\n\nclass Pelicula {\n  -String estudio\n  -List~Actor~ actores\n  +agregarActor()\n  +eliminarActor()\n  +getActores()\n  +mostrarDetalles()\n}\n\nclass SerieDeTV {\n  -List~Temporada~ listaTemporadas\n  +agregarTemporada()\n  +eliminarTemporada()\n  +getTemporadas()\n  +mostrarDetalles()\n}\n\nclass Documental {\n  -String tema\n  -List~Investigador~ investigadores\n  +agregarInvestigador()\n  +eliminarInvestigador()\n  +getInvestigadores()\n  +mostrarDetalles()\n}\n\nclass Actor {\n  -String nombre\n  -String nacionalidad\n  -int edad\n  +mostrarInformacion()\n}\n\nclass Temporada {\n  -int numeroTemporada\n  -int anioEstreno\n  -int numeroEpisodios\n  +mostrarInformacion()\n}\n\nclass Investigador {\n  -String nombre\n  -String especialidad\n  -String institucion\n  +mostrarInformacion()\n}\n\nclass VideoMusical {\n  -String artistaPrincipal\n  -String selloDiscografico\n  -int anioLanzamiento\n  -List~Actor~ actoresParticipantes\n  +agregarActorParticipante()\n  +eliminarActorParticipante()\n  +getActoresParticipantes()\n  +mostrarDetalles()\n}\n\nclass ConferenciaCientifica {\n  -String temaCentral\n  -String institucionOrganizadora\n  -String fechaRealizacion\n  -String modalidad\n  -List~Investigador~ investigadores\n  +agregarInvestigador()\n  +eliminarInvestigador()\n  +getInvestigadores()\n  +mostrarDetalles()\n}\n\nContenidoAudiovisual &lt;|-- Pelicula\nContenidoAudiovisual &lt;|-- SerieDeTV\nContenidoAudiovisual &lt;|-- Documental\nContenidoAudiovisual &lt;|-- VideoMusical\nContenidoAudiovisual &lt;|-- ConferenciaCientifica\n\nPelicula \&quot;0..*\&quot; -- \&quot;0..*\&quot; Actor : asociacion\nSerieDeTV \&quot;1\&quot; *-- \&quot;0..*\&quot; Temporada : composicion\nDocumental \&quot;0..*\&quot; o-- \&quot;0..*\&quot; Investigador : agregacion\n\nVideoMusical \&quot;0..*\&quot; -- \&quot;0..*\&quot; Actor : participantes\nConferenciaCientifica \&quot;0..*\&quot; o-- \&quot;0..*\&quot; Investigador : investigadores\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZAaF6BKjhmP_jFjYZpmY-1">
